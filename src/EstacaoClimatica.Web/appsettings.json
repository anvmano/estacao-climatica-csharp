{
  "Firebase": {
    "DatabaseUrl": "https://seu-projeto-default-rtdb.firebaseio.com",
    "CacheDurationSeconds": 30,
    "MaxRetryAttempts": 3,
    "Paths": {
      "Room": "historico/Temperatura",
      "Solar": "historico/NascePorDoSol",
      "Aquarium": "historico/Aquario",
      "LivingRoom": "historico/AirQuality"
    }
  },
  "Colors": {
    "Blue": "#38bdf8",
    "Green": "#34d399",
    "Purple": "#a78bfa",
    "Amber": "#fbbf24",
    "Teal": "#2dd4bf",
    "Rose": "#fb7185"
  },
  "ArtificialIntelligence": {
    "Enabled": false,
    "Provider": "FirebaseAI",
    "Model": "gemini-3.5-flash",
    "ApiKey": "",
    "Endpoint": "https://generativelanguage.googleapis.com/v1beta",
    "MaxPeriodDays": 30,
    "MaxPromptChars": 9000,
    "RequireAppCheck": false,
    "AppCheck": {
      "Provider": "RecaptchaEnterprise",
      "SiteKey": "",
      "EnforceAfterProductionValidation": false
    }
  },
  "PublicWeather": {
    "BrasilApiCepUrl": "https://brasilapi.com.br/api/cep/v2",
    "ViaCepUrl": "https://viacep.com.br/ws",
    "OpenMeteoGeocodingUrl": "https://geocoding-api.open-meteo.com/v1/search",
    "OpenMeteoForecastUrl": "https://api.open-meteo.com/v1/forecast",
    "OpenMeteoAirQualityUrl": "https://air-quality-api.open-meteo.com/v1/air-quality"
  },
  "InternalAccess": {
    "Enforce": true,
    "AuthorizedEmails": [
      "usuario@example.com",
      "outra@example.com"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
